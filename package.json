{
  "name": "simpledash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "content:images": "node scripts/content-images.mjs",
    "content:screenshots": "node scripts/content-screenshots.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "globe:data": "node scripts/globe-data.mjs"
  },
  "dependencies": {
    "@dicebear/core": "9.4.3",
    "@dicebear/notionists": "9.4.3",
    "@google-analytics/admin": "10.1.1",
    "@google-analytics/data": "7.2.1",
    "@react-email/components": "1.0.12",
    "@sentry/nextjs": "11.6.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.17",
    "google-auth-library": "11.2.0",
