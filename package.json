    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "topojson-client": "3.1.0",
    "zod": "4.6.6"
