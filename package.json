    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cobe": "2.0.1",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "11.2.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "resend": "6.32.1",
    "server-only": "0.0.1",
