# SimpleDash environment variables (docs/SPEC.md section 22).
# Copy to .env for local development. For production, deploy/setup.sh builds
# deploy/secrets/app.env from this file (docs/deploy.md); the server keeps a copy.
# Never commit real values. src/lib/env.ts checks them with Zod when the server starts.

# ── App ───────────────────────────────────────────────────────────────
# Absolute base URL: canonical links, emails and the Better Auth callback.
# Local: http://localhost:3000 · Production: https://simpledash.app
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────
# Postgres. Local Docker: postgres://simpledash:simpledash@localhost:5432/simpledash
# Percent-encode special characters in the password (for example @ becomes %40).
# On the server, deploy/compose.yaml sets it from POSTGRES_PASSWORD, so app.env leaves it out.
DATABASE_URL=postgres://simpledash:simpledash@localhost:5432/simpledash
# Server only: the password of the Postgres container (letters and digits). Set once, by
# deploy/setup.sh; changing it later locks the app out of the existing database.
POSTGRES_PASSWORD=

# ── Sign-in (Better Auth + Google) ───────────────────────────────────
# Signs sessions and encrypts the stored Google tokens. 32+ random characters:
#   openssl rand -base64 48
# Changing it logs everyone out and means users must reconnect Google.
BETTER_AUTH_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Scheduled jobs ────────────────────────────────────────────────────
# Bearer token for /api/internal/jobs/*. Random: openssl rand -base64 32
CRON_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Sender of the weekly email. The domain must be verified in Resend.
EMAIL_FROM=SimpleDash <hello@simpledash.app>
# Signs one-click unsubscribe links (HMAC). Random: openssl rand -base64 48
EMAIL_TOKEN_SECRET=

# ── Payments (Stripe, with Managed Payments) ─────────────────────────
# Use test keys (sk_test_…) in development.
STRIPE_SECRET_KEY=
# Optional: not used by the server (Checkout is a redirect), kept for reference.
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint (<APP_URL>/api/stripe/webhook), or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# The two prices of the Pro product: $9 a month and $90 a year, tax included.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Stripe Managed Payments (Stripe as merchant of record). "true" unless the account isn't approved yet.
STRIPE_MANAGED_PAYMENTS=true

# ── Errors (Sentry, server only) ──────────────────────────────────────
# Optional. Without it, errors are only logged. Server errors only: no browser SDK.
SENTRY_DSN=

# ── Admin ─────────────────────────────────────────────────────────────
# Comma-separated emails that can open /admin (usage counts).
ADMIN_EMAILS=

# ── Backups (the backup helper container on the server, not the app) ──
# See docs/backup.md. Database to dump: on the server, deploy/compose.yaml sets it.
BACKUP_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
