# Caddy in front of the app (docs/deploy.md). Cloudflare connects on 443 with SSL mode
# Full (strict), so Caddy serves the Cloudflare Origin Certificate and never asks Let's Encrypt.
{
	auto_https off
}

:443 {
	tls /certs/origin.pem /certs/origin-key.pem

	encode zstd gzip

	# www.simpledash.app → simpledash.app
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Jobs are called from inside the app container only (deploy/simpledash job).
	respond /api/internal/* 404

	reverse_proxy app:3000
}

:80 {
	redir https://{host}{uri} permanent
}
